generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LOCKED
  DISABLED
  ARCHIVED
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  RETIRED
  RESIGNED
}

enum PermissionScope {
  OWN
  DIRECT_REPORTS
  ORG_UNIT
  ORG_SUBTREE
  ORGANIZATION
  ASSIGNED
  GLOBAL
}

enum PerformanceCycleStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum PerformanceReviewStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  RETURNED
  RESUBMITTED
  APPROVED
  REJECTED
  FINALIZED
  LOCKED
  CANCELLED
}

enum WorkflowStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  RETURNED
  REJECTED
  CANCELLED
}

enum WorkflowActorType {
  EMPLOYEE
  DIRECT_SUPERVISOR
  ROLE
  SPECIFIC_USER
  ORG_UNIT_HEAD
  HR
  PMS_ADMIN
}

enum WorkflowActionType {
  SUBMIT
  APPROVE
  RETURN
  REJECT
  RESUBMIT
  DELEGATE
  CANCEL
}

enum AuthenticationEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  MFA_SUCCESS
  MFA_FAILURE
  SESSION_REVOKED
}

enum NotificationType {
  WORKFLOW
  SYSTEM
  SECURITY
  REMINDER
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum SystemEventSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum BackupType {
  DATABASE
  FILES
  FULL
}

enum BackupStatus {
  STARTED
  SUCCESS
  FAILED
  RESTORED
}

enum ReportingRelationshipType {
  DIRECT
  ACTING
  MATRIX
  SECONDARY
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  description String?
  logoUrl     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unitTypes      OrganizationalUnitType[]
  units          OrganizationalUnit[]
  designations   Designation[]
  employees      Employee[]
  roles          Role[]
  kpis           Kpi[]
  competencies   Competency[]
  ratingScales   RatingScale[]
  programs       PerformanceProgram[]
  workflows      Workflow[]
  systemSettings SystemSetting[]

  @@index([active])
}

model OrganizationalUnitType {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  code           String
  description    String?
  level          Int?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  units        OrganizationalUnit[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model OrganizationalUnit {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  parentId       String?  @db.Uuid
  unitTypeId     String?  @db.Uuid
  name           String
  code           String
  description    String?
  headEmployeeId String?  @db.Uuid
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       OrganizationalUnit?     @relation("UnitHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     OrganizationalUnit[]    @relation("UnitHierarchy")
  unitType     OrganizationalUnitType? @relation(fields: [unitTypeId], references: [id], onDelete: SetNull)
  headEmployee Employee?               @relation("UnitHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)

  assignments EmployeeOrganizationalUnit[]
  roles       Role[]
  reviews     PerformanceReview[] @relation("ReviewOrgUnitSnapshot")

  @@unique([organizationId, code])
  @@index([organizationId, parentId])
  @@index([unitTypeId])
  @@index([headEmployeeId])
  @@index([active])
}

model Designation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  code           String
  description    String?
  gradeLevel     String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]
  assignments  EmployeeOrganizationalUnit[]
  reviews      PerformanceReview[] @relation("ReviewDesignationSnapshot")

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model Employee {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  employeeNumber   String
  firstName        String
  middleName       String?
  lastName         String
  email            String?
  phone            String?
  designationId    String?          @db.Uuid
  employmentStatus EmploymentStatus @default(ACTIVE)
  dateOfEmployment DateTime?
  dateOfExit       DateTime?
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  designation  Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  user         User?

  assignments       EmployeeOrganizationalUnit[]
  reportsTo         ReportingRelationship[] @relation("EmployeeReportsTo")
  directReports     ReportingRelationship[] @relation("EmployeeDirectReports")
  unitHeads         OrganizationalUnit[] @relation("UnitHead")
  reviews           PerformanceReview[] @relation("ReviewEmployee")
  performanceKpis   PerformanceKpi[] @relation("KpiEmployee")
  supervisedAssignments EmployeeOrganizationalUnit[] @relation("AssignmentSupervisor")

  @@unique([organizationId, employeeNumber])
  @@index([organizationId, active])
  @@index([designationId])
  @@index([employmentStatus])
}

model EmployeeOrganizationalUnit {
  id                   String   @id @default(uuid()) @db.Uuid
  employeeId           String   @db.Uuid
  organizationalUnitId String   @db.Uuid
  designationId        String?  @db.Uuid
  supervisorEmployeeId String?  @db.Uuid
  isPrimary            Boolean  @default(true)
  startDate            DateTime
  endDate              DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  employee           Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organizationalUnit OrganizationalUnit @relation(fields: [organizationalUnitId], references: [id], onDelete: Restrict)
  designation        Designation?       @relation(fields: [designationId], references: [id], onDelete: SetNull)
  supervisor         Employee?          @relation("AssignmentSupervisor", fields: [supervisorEmployeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, isPrimary])
  @@index([organizationalUnitId, startDate, endDate])
  @@index([supervisorEmployeeId])
}

model ReportingRelationship {
  id                  String                    @id @default(uuid()) @db.Uuid
  employeeId          String                    @db.Uuid
  reportsToEmployeeId String                    @db.Uuid
  relationshipType    ReportingRelationshipType @default(DIRECT)
  startDate           DateTime
  endDate             DateTime?
  active              Boolean                   @default(true)
  createdAt           DateTime                  @default(now())

  employee          Employee @relation("EmployeeReportsTo", fields: [employeeId], references: [id], onDelete: Cascade)
  reportsToEmployee Employee @relation("EmployeeDirectReports", fields: [reportsToEmployeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, active])
  @@index([reportsToEmployeeId, active])
}

model User {
  id                   String        @id @default(uuid()) @db.Uuid
  employeeId           String        @unique @db.Uuid
  username             String        @unique
  passwordHash         String
  accountStatus        AccountStatus @default(PENDING)
  emailVerified        Boolean       @default(false)
  mfaEnabled           Boolean       @default(false)
  lastLoginAt          DateTime?
  passwordChangedAt    DateTime?
  failedLoginCount     Int           @default(0)
  lockedUntil          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  employee             Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  roles                UserRole[]
  sessions             Session[]
  authenticationEvents AuthenticationEvent[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  workflowActions      WorkflowAction[]
  delegationsGiven     Delegation[] @relation("DelegationsGiven")
  delegationsReceived  Delegation[] @relation("DelegationsReceived")
  systemSettings       SystemSetting[]

  @@index([accountStatus])
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  tokenHash      String   @unique
  ipAddress      String?
  userAgent      String?
  deviceInfo     String?
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuthenticationEvent {
  id         String                  @id @default(uuid()) @db.Uuid
  userId     String?                 @db.Uuid
  eventType  AuthenticationEventType
  success    Boolean
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime                @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([success, createdAt])
}

model Role {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String?  @db.Uuid
  organizationalUnitId String?  @db.Uuid
  name                 String
  code                 String
  description          String?
  systemRole           Boolean  @default(false)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization       Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationalUnit OrganizationalUnit? @relation(fields: [organizationalUnitId], references: [id], onDelete: SetNull)
  userRoles          UserRole[]
  permissions        RolePermission[]
  workflowSteps      WorkflowStep[]

  @@unique([organizationId, code])
  @@index([organizationalUnitId])
  @@index([active])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  module      String
  action      String
  resource    String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  id           String          @id @default(uuid()) @db.Uuid
  roleId       String          @db.Uuid
  permissionId String          @db.Uuid
  scope        PermissionScope @default(OWN)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedBy String?  @db.Uuid
  assignedAt DateTime @default(now())
  expiresAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model PerformanceProgram {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  code           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  cycles       PerformanceCycle[]
  reviewTypes  PerformanceReviewType[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model PerformanceCycle {
  id          String                 @id @default(uuid()) @db.Uuid
  programId   String                 @db.Uuid
  name        String
  code        String
  year        Int?
  startDate   DateTime
  endDate     DateTime
  status      PerformanceCycleStatus @default(DRAFT)
  createdBy   String?                @db.Uuid
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  program PerformanceProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  reviews PerformanceReview[]

  @@unique([programId, code])
  @@index([programId, status])
  @@index([startDate, endDate])
}

model PerformanceReviewType {
  id          String   @id @default(uuid()) @db.Uuid
  programId   String?  @db.Uuid
  name        String
  code        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program   PerformanceProgram? @relation(fields: [programId], references: [id], onDelete: Cascade)
  reviews   PerformanceReview[]
  workflows Workflow[]

  @@unique([programId, code])
  @@index([active])
}

model PerformanceReview {
  id                          String                  @id @default(uuid()) @db.Uuid
  employeeId                  String                  @db.Uuid
  performanceCycleId         String                  @db.Uuid
  reviewTypeId                String                  @db.Uuid
  status                      PerformanceReviewStatus @default(DRAFT)
  organizationUnitIdSnapshot  String?                 @db.Uuid
  designationIdSnapshot       String?                 @db.Uuid
  supervisorEmployeeIdSnapshot String?                @db.Uuid
  organizationUnitNameSnapshot String?
  designationNameSnapshot     String?
  supervisorNameSnapshot      String?
  startedAt                   DateTime?
  submittedAt                DateTime?
  completedAt                DateTime?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  employee         Employee              @relation("ReviewEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  performanceCycle PerformanceCycle      @relation(fields: [performanceCycleId], references: [id], onDelete: Restrict)
  reviewType       PerformanceReviewType @relation(fields: [reviewTypeId], references: [id], onDelete: Restrict)
  organizationUnit OrganizationalUnit?   @relation("ReviewOrgUnitSnapshot", fields: [organizationUnitIdSnapshot], references: [id], onDelete: SetNull)
  designation      Designation?          @relation("ReviewDesignationSnapshot", fields: [designationIdSnapshot], references: [id], onDelete: SetNull)

  kpis             PerformanceKpi[]
  competencies     PerformanceCompetency[]
  scores           PerformanceScore[]
  evidence         Evidence[]
  workflowInstance WorkflowInstance?

  @@unique([employeeId, performanceCycleId, reviewTypeId])
  @@index([performanceCycleId, status])
  @@index([employeeId, status])
  @@index([reviewTypeId])
}

model Kpi {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  name              String
  code              String
  description       String?
  measurementMethod String?
  defaultUnit       String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments  PerformanceKpi[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model PerformanceKpi {
  id                  String   @id @default(uuid()) @db.Uuid
  performanceReviewId String   @db.Uuid
  kpiId               String?  @db.Uuid
  employeeId          String   @db.Uuid
  title               String
  description         String?
  target              String?
  measurementUnit     String?
  weight              Decimal  @db.Decimal(8, 4)
  actualResult        String?
  employeeComment     String?
  supervisorComment   String?
  employeeScore       Decimal? @db.Decimal(8, 4)
  supervisorScore     Decimal? @db.Decimal(8, 4)
  status              String   @default("PENDING")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  performanceReview PerformanceReview @relation(fields: [performanceReviewId], references: [id], onDelete: Cascade)
  kpi              Kpi?              @relation(fields: [kpiId], references: [id], onDelete: SetNull)
  employee         Employee          @relation("KpiEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  evidence         Evidence[]

  @@index([performanceReviewId])
  @@index([kpiId])
  @@index([employeeId])
}

model Competency {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  code           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments  PerformanceCompetency[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model PerformanceCompetency {
  id                  String   @id @default(uuid()) @db.Uuid
  performanceReviewId String   @db.Uuid
  competencyId        String?  @db.Uuid
  weight              Decimal  @db.Decimal(8, 4)
  employeeRating      Decimal? @db.Decimal(8, 4)
  supervisorRating    Decimal? @db.Decimal(8, 4)
  employeeComment     String?
  supervisorComment   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  performanceReview PerformanceReview @relation(fields: [performanceReviewId], references: [id], onDelete: Cascade)
  competency       Competency?       @relation(fields: [competencyId], references: [id], onDelete: SetNull)
  evidence         Evidence[]

  @@index([performanceReviewId])
  @@index([competencyId])
}

model RatingScale {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  code           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items        RatingScaleItem[]
  scores       PerformanceScore[]

  @@unique([organizationId, code])
}

model RatingScaleItem {
  id           String  @id @default(uuid()) @db.Uuid
  ratingScaleId String @db.Uuid
  value        Decimal @db.Decimal(8, 4)
  label        String
  description  String?
  minScore     Decimal? @db.Decimal(8, 4)
  maxScore     Decimal? @db.Decimal(8, 4)

  ratingScale RatingScale @relation(fields: [ratingScaleId], references: [id], onDelete: Cascade)

  @@unique([ratingScaleId, value])
}

model PerformanceScore {
  id                  String   @id @default(uuid()) @db.Uuid
  performanceReviewId String   @db.Uuid
  ratingScaleId       String?  @db.Uuid
  kpiScore            Decimal? @db.Decimal(8, 4)
  competencyScore     Decimal? @db.Decimal(8, 4)
  overallScore        Decimal? @db.Decimal(8, 4)
  overallRating       String?
  calculationVersion  String   @default("1.0")
  calculatedAt        DateTime @default(now())

  performanceReview PerformanceReview @relation(fields: [performanceReviewId], references: [id], onDelete: Cascade)
  ratingScale       RatingScale?      @relation(fields: [ratingScaleId], references: [id], onDelete: SetNull)

  @@index([performanceReviewId])
}

model Evidence {
  id                     String   @id @default(uuid()) @db.Uuid
  performanceReviewId    String   @db.Uuid
  performanceKpiId       String?  @db.Uuid
  performanceCompetencyId String? @db.Uuid
  uploadedBy             String   @db.Uuid
  fileName               String
  storageKey             String
  mimeType               String?
  fileSize               BigInt?
  checksum               String?
  description            String?
  createdAt              DateTime @default(now())

  performanceReview PerformanceReview     @relation(fields: [performanceReviewId], references: [id], onDelete: Cascade)
  performanceKpi    PerformanceKpi?       @relation(fields: [performanceKpiId], references: [id], onDelete: Cascade)
  performanceCompetency PerformanceCompetency? @relation(fields: [performanceCompetencyId], references: [id], onDelete: Cascade)

  @@index([performanceReviewId])
  @@index([performanceKpiId])
  @@index([performanceCompetencyId])
}

model Workflow {
  id                     String   @id @default(uuid()) @db.Uuid
  organizationId         String   @db.Uuid
  performanceReviewTypeId String? @db.Uuid
  name                   String
  code                   String
  description            String?
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  performanceReviewType PerformanceReviewType? @relation(fields: [performanceReviewTypeId], references: [id], onDelete: SetNull)
  steps                WorkflowStep[]
  instances             WorkflowInstance[]

  @@unique([organizationId, code])
  @@index([performanceReviewTypeId])
}

model WorkflowStep {
  id          String            @id @default(uuid()) @db.Uuid
  workflowId  String            @db.Uuid
  stepOrder   Int
  name        String
  description String?
  actorType   WorkflowActorType
  actorRoleId String?           @db.Uuid
  actorUserId String?           @db.Uuid
  required    Boolean           @default(true)
  canReturn   Boolean           @default(true)
  canReject   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workflow  Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  actorRole Role?             @relation(fields: [actorRoleId], references: [id], onDelete: SetNull)
  actorUser User?             @relation("WorkflowStepActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  instances WorkflowInstance[]
  actions   WorkflowAction[]

  @@unique([workflowId, stepOrder])
  @@index([actorRoleId])
  @@index([actorUserId])
}

model WorkflowInstance {
  id                  String         @id @default(uuid()) @db.Uuid
  workflowId          String         @db.Uuid
  performanceReviewId String         @unique @db.Uuid
  currentStepId       String?        @db.Uuid
  status              WorkflowStatus @default(PENDING)
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  workflow          Workflow          @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  performanceReview PerformanceReview @relation(fields: [performanceReviewId], references: [id], onDelete: Cascade)
  currentStep       WorkflowStep?     @relation(fields: [currentStepId], references: [id], onDelete: SetNull)
  actions           WorkflowAction[]

  @@index([workflowId, status])
  @@index([currentStepId])
}

model WorkflowAction {
  id                 String             @id @default(uuid()) @db.Uuid
  workflowInstanceId String             @db.Uuid
  workflowStepId     String             @db.Uuid
  performedBy        String             @db.Uuid
  action             WorkflowActionType
  comment            String?
  createdAt          DateTime           @default(now())

  workflowInstance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  workflowStep     WorkflowStep     @relation(fields: [workflowStepId], references: [id], onDelete: Restrict)
  user             User             @relation(fields: [performedBy], references: [id], onDelete: Restrict)

  @@index([workflowInstanceId, createdAt])
  @@index([performedBy, createdAt])
}

model Delegation {
  id          String   @id @default(uuid()) @db.Uuid
  delegatedBy String   @db.Uuid
  delegatedTo String   @db.Uuid
  workflowId  String?  @db.Uuid
  startDate   DateTime
  endDate     DateTime
  reason      String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  delegator User @relation("DelegationsGiven", fields: [delegatedBy], references: [id], onDelete: Restrict)
  delegate  User @relation("DelegationsReceived", fields: [delegatedTo], references: [id], onDelete: Restrict)

  @@index([delegatedBy, active])
  @@index([delegatedTo, active])
  @@index([startDate, endDate])
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  type       NotificationType
  title      String
  message    String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String?       @db.Uuid
  action     String
  module     String
  entityType String
  entityId   String?
  severity   AuditSeverity @default(INFO)
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([module, createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([severity, createdAt])
}

model SystemSetting {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  key            String
  value          String
  valueType      String   @default("string")
  description    String?
  updatedBy      String?  @db.Uuid
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updater      User?         @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([organizationId, key])
  @@index([key])
}

model SystemEvent {
  id         String              @id @default(uuid()) @db.Uuid
  eventType  String
  severity   SystemEventSeverity @default(INFO)
  message    String
  metadata   Json?
  createdAt  DateTime            @default(now())

  @@index([eventType, createdAt])
  @@index([severity, createdAt])
}

model BackupRecord {
  id          String       @id @default(uuid()) @db.Uuid
  backupType  BackupType
  location    String
  sizeBytes   BigInt?
  status      BackupStatus
  startedAt   DateTime
  completedAt DateTime?
  createdBy   String?      @db.Uuid
  createdAt   DateTime     @default(now())

  @@index([backupType, status])
  @@index([startedAt])
}
