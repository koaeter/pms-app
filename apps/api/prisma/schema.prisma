generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  username     String      @unique
  passwordHash String
  firstName    String
  lastName     String
  email        String?     @unique
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  sessions     Session[]
  roles        UserRole[]
  employee     Employee?
  notifications Notification[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isRead, createdAt])
}

model Organisation {
  id String @id @default(uuid())
  name String @unique
  code String @unique
  description String?
  isActive Boolean @default(true)
  departments Department[]
  designations Designation[]
  employees Employee[]
  programmes PerformanceProgramme[]
  cycles PerformanceCycle[]
  ratingScales RatingScale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id String @id @default(uuid())
  userId String @unique
  employeeNumber String @unique
  organisationId String?
  designationId String?
  departmentId String?
  managerId String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation? @relation(fields: [organisationId], references: [id])
  designation Designation? @relation(fields: [designationId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  manager Employee? @relation("EmployeeManager", fields: [managerId], references: [id])
  reports Employee[] @relation("EmployeeManager")
  performancePlans PerformancePlan[]
  reviewerPlans PerformancePlan[] @relation("PerformancePlanReviewer")
  finalAssessorPlans PerformancePlan[] @relation("PerformancePlanFinalAssessor")
  assessmentsGiven PerformanceAssessment[] @relation("Assessor")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organisationId])
  @@index([departmentId])
  @@index([managerId])
}

model Department {
  id String @id @default(uuid())
  organisationId String
  name String
  code String
  parentId String?
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  parent Department? @relation("DepartmentTree", fields: [parentId], references: [id])
  children Department[] @relation("DepartmentTree")
  employees Employee[]
  @@unique([organisationId, name])
  @@unique([organisationId, code])
  @@index([organisationId])
  @@index([parentId])
}

model Designation {
  id String @id @default(uuid())
  organisationId String
  name String
  code String?
  grade String?
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employees Employee[]
  @@unique([organisationId, name])
  @@unique([organisationId, code])
  @@index([organisationId])
}

model Role {
  id String @id @default(uuid())
  name String @unique
  description String?
  users UserRole[]
  permissions RolePermission[]
}

model Permission {
  id String @id @default(uuid())
  code String @unique
  description String?
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model RolePermission {
  roleId String
  permissionId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model PerformanceProgramme {
  id String @id @default(uuid())
  organisationId String
  name String
  code String
  description String?
  isActive Boolean @default(true)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  reviewTypes ReviewType[]
  cycles PerformanceCycle[]
  kpis Kpi[]
  competencies Competency[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organisationId, code])
  @@index([organisationId])
}

model ReviewType {
  id String @id @default(uuid())
  programmeId String
  name String
  code String
  description String?
  programme PerformanceProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  cycles PerformanceCycle[]
  plans PerformancePlan[]
  @@unique([programmeId, code])
  @@index([programmeId])
}

model PerformanceCycle {
  id String @id @default(uuid())
  organisationId String
  programmeId String
  reviewTypeId String
  name String
  startsAt DateTime
  endsAt DateTime
  status CycleStatus @default(DRAFT)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  programme PerformanceProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  reviewType ReviewType @relation(fields: [reviewTypeId], references: [id])
  plans PerformancePlan[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organisationId])
  @@index([programmeId])
  @@index([reviewTypeId])
}

enum CycleStatus { DRAFT OPEN REVIEW CLOSED }

model Kpi {
  id String @id @default(uuid())
  programmeId String
  name String
  code String
  description String?
  defaultWeight Decimal? @db.Decimal(5,2)
  programme PerformanceProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  planItems PerformancePlanItem[]
  @@unique([programmeId, code])
  @@index([programmeId])
}

model Competency {
  id String @id @default(uuid())
  programmeId String
  name String
  code String
  description String?
  defaultWeight Decimal? @db.Decimal(5,2)
  programme PerformanceProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  planItems PerformancePlanItem[]
  @@unique([programmeId, code])
  @@index([programmeId])
}

model RatingScale {
  id String @id @default(uuid())
  organisationId String
  name String
  description String?
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  levels RatingLevel[]
  assessmentItems PerformanceAssessmentItem[]
  @@unique([organisationId, name])
  @@index([organisationId])
}

model RatingLevel {
  id String @id @default(uuid())
  scaleId String
  name String
  score Decimal @db.Decimal(6,2)
  description String?
  scale RatingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  assessmentItems PerformanceAssessmentItem[]
  @@unique([scaleId, name])
  @@index([scaleId])
}

model PerformancePlan {
  id String @id @default(uuid())
  employeeId String
  cycleId String
  reviewTypeId String
  reviewerId String?
  finalAssessorId String?
  status PlanStatus @default(DRAFT)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycle PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  reviewType ReviewType @relation(fields: [reviewTypeId], references: [id])
  reviewer Employee? @relation("PerformancePlanReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  finalAssessor Employee? @relation("PerformancePlanFinalAssessor", fields: [finalAssessorId], references: [id], onDelete: SetNull)
  items PerformancePlanItem[]
  assessments PerformanceAssessment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([employeeId, cycleId, reviewTypeId])
  @@index([cycleId])
  @@index([employeeId])
  @@index([reviewerId])
  @@index([finalAssessorId])
}

enum PlanStatus { DRAFT SUBMITTED IN_REVIEW APPROVED LOCKED }
enum PlanItemType { KPI COMPETENCY }
enum AssessorType { SELF SUPERVISOR REVIEWER FINAL }
enum AssessmentStatus { DRAFT SUBMITTED APPROVED }

model PerformancePlanItem {
  id String @id @default(uuid())
  planId String
  type PlanItemType
  kpiId String?
  competencyId String?
  description String?
  weight Decimal @db.Decimal(5,2)
  target String?
  plan PerformancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  kpi Kpi? @relation(fields: [kpiId], references: [id])
  competency Competency? @relation(fields: [competencyId], references: [id])
  assessmentItems PerformanceAssessmentItem[]
  @@index([planId])
  @@index([kpiId])
  @@index([competencyId])
}

model PerformanceAssessment {
  id String @id @default(uuid())
  planId String
  assessorId String
  assessorType AssessorType
  status AssessmentStatus @default(DRAFT)
  overallScore Decimal? @db.Decimal(7,2)
  comment String?
  plan PerformancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  assessor Employee @relation("Assessor", fields: [assessorId], references: [id])
  items PerformanceAssessmentItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([planId, assessorId, assessorType])
  @@index([planId])
  @@index([assessorId])
}

model PerformanceAssessmentItem {
  id String @id @default(uuid())
  assessmentId String
  planItemId String
  ratingScaleId String?
  ratingLevelId String?
  score Decimal? @db.Decimal(7,2)
  comment String?
  assessment PerformanceAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  planItem PerformancePlanItem @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  ratingScale RatingScale? @relation(fields: [ratingScaleId], references: [id])
  ratingLevel RatingLevel? @relation(fields: [ratingLevelId], references: [id])
  @@unique([assessmentId, planItemId])
  @@index([planItemId])
}

model AuditLog {
  id String @id @default(uuid())
  actorId String?
  action String
  entity String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
  @@index([actorId, createdAt])
}
